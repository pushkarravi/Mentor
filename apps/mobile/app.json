{
  "expo": {
    "name": "Mentor",
    "slug": "mentor",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "mentor",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "platforms": ["web", "ios", "android"],
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
