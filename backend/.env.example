# Backend environment variables
# Copy to .env and fill in values for local development

# Database — Prisma uses this for PostgreSQL access
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mentor

# Repository provider: prisma (default when DATABASE_URL is set) or memory
REPOSITORY_PROVIDER=prisma

# AI provider: mock (default) or perplexity
AI_PROVIDER=mock
PERPLEXITY_API_KEY=

# Server port
PORT=3001
