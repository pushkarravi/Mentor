# Mentor backend environment variables

# Database — PostgreSQL connection string for Prisma.
# For local dev: postgresql://user:password@localhost:5432/mentor
# If empty, the backend uses in-memory storage (data lost on restart).
DATABASE_URL=

# AI provider selection: "mock" or "perplexity"
# mock = placeholder responses for testing structure (no API key needed)
# perplexity = real AI reasoning (requires PERPLEXITY_API_KEY)
AI_PROVIDER=mock

# Perplexity API key — only needed when AI_PROVIDER=perplexity
# Get one at https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# Server port (default 3001)
PORT=3001
