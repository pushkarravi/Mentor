# ── Backend ────────────────────────────────────────────────────────────
# PostgreSQL connection string for Prisma.
# For local dev: postgresql://user:password@localhost:5432/mentor
# If empty, the backend uses in-memory storage (data lost on restart).
DATABASE_URL=

# AI provider: "mock" (placeholder responses) or "perplexity" (real AI)
AI_PROVIDER=mock

# Perplexity API key (only needed when AI_PROVIDER=perplexity)
PERPLEXITY_API_KEY=

# Backend port
PORT=3001

# ── Frontend ───────────────────────────────────────────────────────────
# Backend API URL the Expo app connects to
EXPO_PUBLIC_API_URL=http://localhost:3001
